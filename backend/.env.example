# Copie para .env (mesma pasta) e preencha. O arquivo .env não vai para o Git.

# Senha exigida em todo acesso. Obrigatória se o sistema for exposto fora deste computador.
JURISFIND_ACCESS_PASSWORD=

# Chave da Books API do Google (opcional): habilita a fonte "Google Livros".
JURISFIND_GOOGLE_BOOKS_KEY=
